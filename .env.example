# Runtime for single-instance Node Server deployment.
NITRO_PORT=3000
NITRO_HOST=0.0.0.0
TZ=Asia/Shanghai

# Initial administrator account. On first startup the app can use these values
# to create the super administrator; change them in the admin panel afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678
ADMIN_EMAIL=admin@example.com

# Server secrets. Generate unique production values before deployment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_VERIFY_SECRET=this_is_a_email_verify_secret
API_KEY_SECRET=this_is_a_api_key_secret

# PostgreSQL connection string. Production should point at the managed or local
# PostgreSQL instance used by this single Node process.
DATABASE_URL=postgresql://user:password@localhost:5432/OpenAPI
