# Generate two independent 32-byte random values.
NUXT_AUTH_SECRET=
NUXT_API_KEY_SECRET=

# PGlite is suitable for one Platform instance. Use PostgreSQL for multiple
# instances by setting DATABASE_DRIVER=postgres and DATABASE_URL.
DATABASE_DRIVER=pglite
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/openapi

# Optional for one Platform instance; required for multiple instances.
NUXT_REDIS_URL=

# Used by docker-compose to start the bundled official Service. Store the same
# value in the corresponding Internal Upstream through the Platform console.
OPENAPI_SERVICE_TOKEN=
