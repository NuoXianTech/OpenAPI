# 管理员登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_EMAIL=admin@openapi.com

# 邮箱验证码签名密钥
EMAIL_VERIFY_SECRET=openapi-email-verify-secret

# OAuth provider 密钥加密主键（AES-256-GCM，32 字节 hex / base64url / utf-8）
# 生成： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_SECRET_KEY=openapi-oauth-secret-key

# 数据库连接
DATABASE_URL=postgresql://user:password@localhost:5432/OpenApi

# ---- API Guard ----------------------------------------------------
# 限流 driver：
#   memory        进程内，适合 dev / 单实例 prod
#   postgres      基于 api_rate_limit_buckets 表，多实例部署推荐
#   nuxthub-kv    预留，当前回退到 memory
API_GUARD_RATE_LIMIT_DRIVER=memory