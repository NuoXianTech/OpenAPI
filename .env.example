# Runtime for single-instance Node Server deployment.
NITRO_PORT=3000
NITRO_HOST=0.0.0.0
TZ=Asia/Shanghai

# Server secrets. Generate unique production values before deployment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_AUTH_SECRET=
NUXT_AUTH_API_KEY_SECRET=

# Trust X-Forwarded-For only when the direct peer belongs to these CIDRs.
# Example for a local nginx reverse proxy: 127.0.0.1/32,::1/128
# NUXT_PROXY_TRUSTED_CIDRS=127.0.0.1/32,::1/128
# NUXT_PROXY_FORWARDED_HOPS=1

# Optional shared Redis for distributed rate limiting and short-lived public
# response/API guard caches and distributed worker coordination. Set required
# to true for multi-instance production; caches still fall back to the database.
# NUXT_REDIS_URL=redis://127.0.0.1:6379
# NUXT_REDIS_KEY_PREFIX=openapi:
# NUXT_REDIS_CONNECT_TIMEOUT_MS=2000
# NUXT_REDIS_REQUIRED=false

# Database runtime. Choose one mode. With neither option enabled, development
# falls back to PGlite; production requires DATABASE_URL or DATABASE_DRIVER=pglite.
#
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/OpenAPI
#
# PGlite:
# DATABASE_DRIVER=pglite
# PGLITE_DATA_DIR=.data/pglite
