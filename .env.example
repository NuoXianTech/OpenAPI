# ─── 运行时（生产部署 Node Server 使用）─────────────────────
# 默认 NODE_ENV=production 由容器 ENTRYPOINT/启动脚本控制；本地 dev 自动为 development
NITRO_PORT=3000
NITRO_HOST=0.0.0.0
TZ=Asia/Shanghai

# ─── 管理员（首次启动会以此账号注册超管，之后可在后台改）───────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678
ADMIN_EMAIL=admin@example.com

# ─── 服务端密钥（生产请用 openssl rand -hex 32 生成）─────────
# 邮箱验证码 HMAC 签名密钥
EMAIL_VERIFY_SECRET=9ef64578d19e77a7dfa98c745218aef9500239f3dca12e6fb779ae5d3d616e6a
# OAuth provider 密钥加密主键（AES-256-GCM，32 字节 hex / base64url / utf-8）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_SECRET_KEY=7e1a83699fe14e32f1ae075b614abfd82e2ac26997b898799348c174e082c128
# 用户 API Key 生成派生密钥（HMAC-SHA256，32 字节 hex / base64url / utf-8）
# 不同部署用不同的密钥可避免跨环境 Key 冲突；切换密钥不影响存量 Key 的查询
API_KEY_SECRET=4c3a1f8e5d7b6a092138e9f0a4c5b6d7e8f90a1b2c3d4e5f6a7b8c9d0e1f2a3b

# ─── 数据库 ─────────────────────────────────────────────────
# 留空 → dev 自动落到本地 pglite（.data/）；
# 生产请填托管 PG 连接串，记得加 ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/OpenAPI

# ─── 限流 driver（可选，留空走自动）──────────────────────────
# 单实例 Node 留空（=memory）；多实例共享 PG 部署时设 postgres
# NuxtHub 部署会自动检测为 kv
NUXT_API_GUARD_RATE_LIMIT_DRIVER=
