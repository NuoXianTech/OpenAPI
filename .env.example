# Runtime for single-instance Node Server deployment.
NITRO_PORT=3000
NITRO_HOST=0.0.0.0
TZ=Asia/Shanghai

# Server secrets. Generate unique production values before deployment.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_AUTH_SECRET=this_is_a_auth_secret
NUXT_AUTH_API_KEY_SECRET=this_is_a_api_key_secret

# Database runtime. Choose one mode. With neither option enabled, development
# falls back to PGlite; production requires DATABASE_URL or DATABASE_DRIVER=pglite.
#
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/OpenAPI
#
# PGlite:
# DATABASE_DRIVER=pglite
# PGLITE_DATA_DIR=.data/pglite
