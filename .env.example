# =============================================================================
# HTTP server
# =============================================================================

NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# =============================================================================
# Required security secrets
# =============================================================================

# Generate two independent values before starting the application:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NUXT_AUTH_SECRET=
NUXT_API_KEY_SECRET=

# =============================================================================
# Database
# =============================================================================

# Development falls back to PGlite when both values are empty. Production must
# set DATABASE_URL for PostgreSQL or explicitly set DATABASE_DRIVER=pglite.
DATABASE_DRIVER=
DATABASE_URL=
DATABASE_POOL_SIZE=10
DB_AUTO_MIGRATE=true

# PostgreSQL example:
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/openapi

# =============================================================================
# Redis (optional for one instance, required for multiple instances)
# =============================================================================

NUXT_REDIS_URL=
NUXT_REDIS_KEY_PREFIX=openapi:
NUXT_REDIS_CONNECT_TIMEOUT_MS=2000
NUXT_REDIS_REQUIRED=false

# Password-authenticated Redis example. URL-encode special characters in the
# password before placing it in the connection URL.
# NUXT_REDIS_URL=redis://:password@127.0.0.1:6379/0

# =============================================================================
# Reverse proxy (optional)
# =============================================================================

# Only trust proxies that connect directly to this application.
# Example for local nginx: 127.0.0.1/32,::1/128
NUXT_PROXY_TRUSTED_CIDRS=
NUXT_PROXY_FORWARDED_HOPS=1
