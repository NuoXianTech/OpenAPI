# Generate two independent 32-byte random values. Never reuse them.
NUXT_AUTH_SECRET=
NUXT_API_KEY_SECRET=

# Choose one database mode. This default is suitable for one Platform process.
DATABASE_DRIVER=pglite
# PGLITE_DATA_DIR=.data/pglite

# For PostgreSQL, replace the two lines above with the following. Percent-encode
# reserved characters in the username/password. Use sslmode=require when the
# database provider requires TLS.
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/openapi

# Redis is optional for one Platform process. For multiple Platform processes,
# set both values. /0 is the Redis database number; rediss:// enables TLS.
NUXT_REDIS_URL=
# NUXT_REDIS_URL=redis://default:change-me@127.0.0.1:6379/0
# NUXT_REDIS_REQUIRED=true
