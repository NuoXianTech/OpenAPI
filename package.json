{
  "name": "OpenAPI",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "start:cluster": "NITRO_PRESET=node_cluster node .output/server/index.mjs",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:migrate:prod": "NODE_ENV=production nuxt db migrate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:ci": "vitest run tests/e2e --maxWorkers=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@nuxt/ui": "^4.7.1",
    "@nuxthub/core": "^0.10.7",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^8.0.7",
    "nuxt": "^4.4.5",
    "postgres": "^3.4.9",
    "vue": "^3.5.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^24.12.3",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "playwright-core": "^1.59.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
